{
  "name": "1pass-marketing-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start:dev": "npm run dev",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "prod": "npm run start:prod",
    "start:prod": "node --env-file-if-exists=.env --input-type=module -e \"process.env.NODE_ENV='production'; await import('./dist/server.js');\"",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "worker:dev": "node --env-file-if-exists=.env --import tsx --watch src/worker.ts",
    "worker:prod": "node --env-file-if-exists=.env --input-type=module -e \"process.env.NODE_ENV='production'; await import('./dist/worker.js');\"",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:migrate": "npm run migrate",
    "db:status": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts --status",
    "db:deploy": "node --env-file-if-exists=.env dist/db/migrate.js",
    "ops": "node --env-file-if-exists=.env --import tsx src/ops.ts",
    "docs": "tsx scripts/openapi.ts",
    "generate:api": "npm run docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres.test.ts",
    "test:postgres:local": "node scripts/test-postgres.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "lint": "npm run typecheck && npm run format:check"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
