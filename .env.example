# Minimum configuration for local development with sandbox email.
# API defaults to http://localhost:4000; frontend origin to http://localhost:3000.
# Other settings have defaults in src/config.ts.
DATABASE_URL=postgresql://marketing:development-only@localhost:5432/marketing
EMAIL_WEBHOOK_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
# Generate a 32-byte hex key; never use the placeholder.
DATA_KEYS={"v1":"REPLACE_WITH_64_HEX_CHARACTERS"}
SUPPRESSION_HASH_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS

# This adapter saves encrypted email files; it does not send real email.
# A real provider adapter is needed before adding provider credentials can enable delivery.
