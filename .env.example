# Development only. All addresses are placeholders, not company contacts.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://marketing:development-only@localhost:5432/marketing
PUBLIC_API_ORIGIN=http://localhost:4000
MARKETING_SITE_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
EMAIL_PROVIDER=sandbox
EMAIL_WEBHOOK_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
# Generate a 32-byte hex key; never use the placeholder.
DATA_KEYS={"v1":"REPLACE_WITH_64_HEX_CHARACTERS"}
DATA_ACTIVE_KEY=v1
SUPPRESSION_HASH_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
SANDBOX_MAIL_DIR=.sandbox-mail
CONSENT_VERSION=development-marketing-v1
CONSENT_TEXT=DEVELOPMENT ONLY: receive launch updates.
CONTACT_CONSENT_VERSION=development-research-v1
CONTACT_CONSENT_TEXT=DEVELOPMENT ONLY: contact me about this research.
CONFIRM_TOKEN_TTL_HOURS=24
PREFERENCES_SESSION_TTL_MINUTES=30
RESEND_INTERVAL_SECONDS=900
RATE_LIMIT_MAX=60
EMAIL_HOURLY_LIMIT=100
# Proposed development defaults; require approved policy before live collection.
PENDING_RETENTION_DAYS=30
ENQUIRY_RETENTION_DAYS=365
LOG_LEVEL=info
